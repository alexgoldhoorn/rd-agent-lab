# ── LLM Provider ──────────────────────────────────────────────────────
# "openai" or "ollama"  (default: openai)
LLM_PROVIDER=openai

# OpenAI settings (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Ollama settings (required when LLM_PROVIDER=ollama)
# Recommended models with tool-calling support:
#   - mistral          (7B, fast, solid tool use)
#   - llama3.1         (8B/70B, strong reasoning)
#   - command-r        (35B, built for RAG + tools)
#   - qwen2.5         (7B/72B, good multilingual + tools)
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434

# ── Search ────────────────────────────────────────────────────────────
# Tavily web search (optional — skipped if unset)
TAVILY_API_KEY=

# arXiv search is free and always available; toggle it off if needed.
ARXIV_ENABLED=true

# Max results per search tool per hop
SEARCH_MAX_RESULTS=5

# ── Agent ─────────────────────────────────────────────────────────────
# Maximum multi-hop search iterations (1–5)
MAX_SEARCH_HOPS=3

# ── Persistence ───────────────────────────────────────────────────────
# Path to the SQLite checkpoint DB (optional — in-memory if unset)
CHECKPOINT_DB=.citescout_checkpoints.db
